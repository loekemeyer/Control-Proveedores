# Puerto del servidor
PORT=3000

# Contrasena del panel de administracion (cambiala!)
ADMIN_PASSWORD=cambiar-esta-clave

# Ruta del archivo de base de datos SQLite (opcional)
DB_PATH=./data/control.sqlite

# URL publica de la app (para armar los links de proveedores). Opcional.
# Si no se define, se usa el host de la request.
PUBLIC_BASE_URL=
